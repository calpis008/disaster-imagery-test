# ==========================================================================
# ASRS 緊急災害影像線上介接服務 - 環境變數範本
# 複製本檔為 .env（.env 已列入 .gitignore，不會進版控）後填入實際值
# ==========================================================================

# 災害影像探索器（disaster-imagery-explorer）
# ---------------------------------------------------------------------
# ArcGIS Portal 上對應此 App 的 Item ID（選填；留空仍可運作，僅無法記錄使用量）
DISASTER_IMAGERY_EXPLORER_APP_ID =

# 災害應變影像服務（ImageServer）URL（必填）
# 分署自有 DMC III 航攝動態鑲嵌服務（DIMS_DMCIII_8_3），非 Esri drp_imagery 示範服務。
# ArcGIS Portal item id：473e7b17fd4b4a3ebf37d27ad6afc9b9（供追溯服務來源用）
# 範例：https://edi.asrs.gov.tw/geoportal/sharing/servers/473e7b17fd4b4a3ebf37d27ad6afc9b9/rest/services/edi/DIMS_DMCIII_8_3/ImageServer
DISASTER_RESPONSE_SERVICE_URL =

# 一般設定
# ---------------------------------------------------------------------
# ArcGIS Portal 根網址（供搜尋/儲存等功能組合服務網址使用）
ARCGIS_PORTAL_ROOT_URL =

# 底圖 WebMap ID（選填；留空則使用程式內建預設底圖）
IMAGERY_EXPLORER_WEB_MAP_ID =

# 內政部國土測繪中心（NLSC）WMTS 圖資套疊
# ---------------------------------------------------------------------
# NLSC WMTS 服務根網址（選填；留空則使用預設值 https://wmts.nlsc.gov.tw/wmts）
NLSC_WMTS_BASE_URL =

# 「臺灣通用電子地圖透明」圖層 identifier（選填；留空則使用預設值 EMAP2）
# 2026-07-19 以 GetCapabilities 實測確認之 identifier，套疊在災害影像圖層之上作為道路地名參照層。
NLSC_EMAP_LAYER_ID =

# 3D 視角切換（事件 DEM 地形＋航攝影像披覆）
# ---------------------------------------------------------------------
# 分署 DEM 高程快取服務目錄根網址（選填；留空則使用預設值
# https://gisportal.moa.gov.tw/geoserver/rest/services?f=json）
DEM_CATALOG_URL =

# DEM 服務命名前綴，用於從目錄中篩選出 DEM 服務（選填；留空則使用預設值 DEM_）
DEM_SERVICE_PREFIX =
