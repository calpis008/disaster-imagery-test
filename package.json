{
    "name": "asrs-disaster-explorer",
    "version": "1.0.0",
    "description": "ASRS 緊急災害影像線上介接服務 - 農業部航測及遙測分署",
    "main": "index.js",
    "scripts": {
        "test": "jest --passWithNoTests",
        "start": "webpack serve --mode development --open --env app=disasterimageryexplorer --env envFileName=.env",
        "start:dev": "webpack serve --mode development --open --env app=disasterimageryexplorer --env envFileName=.env.development",
        "start:prod": "webpack serve --mode development --open --env app=disasterimageryexplorer --env envFileName=.env.production",
        "build": "webpack --mode production --env app=disasterimageryexplorer --env envFileName=.env",
        "build:dev": "webpack --mode production --env app=disasterimageryexplorer --env envFileName=.env.development",
        "build:prod": "webpack --mode production --env app=disasterimageryexplorer --env envFileName=.env.production",
        "prepare": "husky install",
        "format": "prettier --write \"**/*.{ts,tsx,json,js,md,css}\"",
        "lint": "eslint src --ext .ts,.tsx --fix"
    },
    "lint-staged": {
        "src/**/*.{ts,tsx,json}": [
            "prettier --write",
            "eslint src --fix",
            "jest --bail --findRelatedTests --passWithNoTests"
        ],
        "src/**/*.css}": [
            "prettier --write"
        ],
        "e2e/**/*.{ts,tsx,json}": [
            "prettier --write"
        ],
        "public/**/*.{json,html}": [
            "prettier --write"
        ]
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Esri/imagery-explorer-apps.git"
    },
    "keywords": [
        "landsat",
        "remote-sensing",
        "sentinel-1",
        "sentinel-2",
        "landcover",
        "esri",
        "imagery-explorer-apps",
        "living-atlas"
    ],
    "author": "ArcGIS Living Atlas of the World",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/Esri/imagery-explorer-apps/issues"
    },
    "homepage": "https://github.com/Esri/imagery-explorer-apps",
    "devDependencies": {
        "@babel/core": "^7.28.0",
        "@babel/plugin-transform-runtime": "^7.28.0",
        "@babel/preset-env": "^7.28.0",
        "@babel/preset-react": "^7.27.1",
        "@babel/preset-typescript": "^7.27.1",
        "@babel/runtime": "^7.28.2",
        "@playwright/test": "^1.57.0",
        "@testing-library/react": "^16.3.0",
        "@types/classnames": "^2.2.10",
        "@types/jest": "^29.5.11",
        "@types/node": "^20.14.9",
        "@types/react": "^19.1.9",
        "@types/react-dom": "^19.1.7",
        "@types/react-redux": "^7.1.34",
        "@types/react-responsive": "^8.0.2",
        "@typescript-eslint/eslint-plugin": "6.12",
        "@typescript-eslint/parser": "6.12",
        "autoprefixer": "^10.4.21",
        "babel-loader": "^10.0.0",
        "copy-webpack-plugin": "^14.0.0",
        "css-loader": "^7.1.2",
        "css-minimizer-webpack-plugin": "^8.0.0",
        "dotenv": "^16.4.5",
        "eslint": "8.54",
        "eslint-config-prettier": "^8.5.0",
        "eslint-plugin-react": "^7.30.1",
        "fork-ts-checker-webpack-plugin": "^9.1.0",
        "html-loader": "^5.1.0",
        "html-webpack-plugin": "^5.6.3",
        "husky": "^8.0.1",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "lint-staged": "^17.0.8",
        "mini-css-extract-plugin": "^2.9.2",
        "postcss": "^8.5.16",
        "postcss-loader": "7.3",
        "postcss-preset-env": "8.4",
        "prettier": "^3.6.2",
        "source-map-loader": "^5.0.0",
        "style-loader": "^4.0.0",
        "tailwindcss": "3.3",
        "terser-webpack-plugin": "^5.3.14",
        "ts-node": "^10.9.1",
        "typescript": "^5.9.3",
        "webpack": "^5.101.0",
        "webpack-bundle-analyzer": "^4.4.2",
        "webpack-cli": "^6.0.1",
        "webpack-dev-server": "^5.2.2"
    },
    "dependencies": {
        "@arcgis/core": "^5.1.8",
        "@arcgis/map-components": "^5.1.8",
        "@esri/arcgis-rest-feature-service": "^4.0.4",
        "@esri/calcite-components": "^5.1.1",
        "@reduxjs/toolkit": "2.5",
        "@vannizhang/images-to-video-converter-client": "^1.1.14",
        "@vannizhang/react-d3-charts": "^1.0.38",
        "classnames": "^2.2.6",
        "date-fns": "^2.30.0",
        "date-fns-tz": "^2.0.0",
        "helper-toolkit-ts": "^1.2.1",
        "i18next": "^24.2.3",
        "i18next-http-backend": "^3.0.2",
        "jszip": "^3.10.1",
        "nanoid": "^5.0.9",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "react-i18next": "^15.4.1",
        "react-redux": "9.2",
        "redux": "^5.0.1"
    },
    "browserslist": [
        "defaults"
    ],
    "overrides": {
        "uuid": "^11.1.1"
    }
}
